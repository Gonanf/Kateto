{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    },
    "dev": {
      "dependsOn": [
        "protos#gen"
      ],
      "persistent": true,
      "cache": false
    },
    "gen": {
      "cache": false
    }
  }
}
